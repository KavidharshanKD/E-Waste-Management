# ===================================================================
# Smart E-Waste Management System - Environment Configuration
# ===================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=ewastedb
POSTGRES_USER=ewaste_user
POSTGRES_PASSWORD=ewaste_password_change_in_production
POSTGRES_PORT=5432

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
JWT_SECRET=your_secure_jwt_secret_here_change_in_production

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Razorpay Payment Gateway (Optional for Test/Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_CURRENCY=INR
RAZORPAY_SANDBOX_MODE=true

